module m{func t(v:int)type void{let a=v+128 let b=a+128 let c=b%2 let d=if c==1 then(b+1)%256 else(b-1)%256 let e=d%2 let f=if e==1 then(d+1)%256 else(d-1)%256 assert f==v let r=v+1-v%2*2 print_int(v)print(" ")print_int(v+128)print(" ")print_int(v)print(" ")print_int(r)print(" ")print_int(v)print("\n")}func main()type void{let i:int=0 while i<20{t(i)let i:int=i+1}print("Done\n")}}